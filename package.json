{
  "name": "sikons",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx server/database/migrate.ts",
    "db:seed": "node --import tsx server/database/seed.ts",
    "db:reset": "node --import tsx server/database/clean.ts && pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nuxt/ui": "^2.22.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.40.0",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "0.368.0",
    "mysql2": "^3.12.0",
    "nuxt": "^3.16.0",
    "vue": "3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.13",
      "@vue/shared": "3.5.13",
      "@vue/runtime-core": "3.5.13",
      "@vue/runtime-dom": "3.5.13",
      "@vue/compiler-core": "3.5.13",
      "@vue/compiler-dom": "3.5.13",
      "@vue/compiler-sfc": "3.5.13",
      "@vue/reactivity": "3.5.13"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
